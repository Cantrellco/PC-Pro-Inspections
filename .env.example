# Server-side only — set these in Vercel → Project → Settings → Environment Variables.
# They are read by api/google-reviews.js and never reach the browser.

# Google Cloud API key with "Places API (New)" enabled. Restrict it to that API.
GOOGLE_PLACES_API_KEY=

# Optional. The listing's Place ID (ChIJ…). Leave blank to auto-resolve by name.
GOOGLE_PLACE_ID=

# Optional. Text used to auto-resolve the Place ID when GOOGLE_PLACE_ID is blank.
GOOGLE_PLACE_QUERY=PC Pro Inspections Fairfield IL 62837
